    "UserData": {
     "Fn::Base64": {
      "Fn::Join": [
       "",
       [
        "#!/bin/bash\n# 1. Update the computer's software\nyum update -y\n# 2. Install Java (needed to run Kafka)\nyum install -y java-17-amazon-corretto wget\n\ncd /home/ec2-user\n\n# 3. Download the Kafka software from the internet\nwget https://downloads.apache.org/kafka/3.9.2/kafka_2.13-3.9.2.tgz\n# 4. Unpack the software\ntar -xzf kafka_2.13-3.9.2.tgz\n\ncd kafka_2.13-3.9.2\n\n# 5. Start Zookeeper (the coordinator) in the background\nnohup bin/zookeeper-server-start.sh config/zookeeper.properties > zookeeper.log 2>&1 &\n# wait for zookeeper to Start\nsleep 10\n\n# 6. Configure Kafka with private IP for internal network communication\nPRIVATE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)\necho \"advertised.listeners=PLAINTEXT://$PRIVATE_IP:9092\" >> config/server.properties\n\n# 7. Start the Kafka server itself in the background\nnohup bin/kafka-server-start.sh config/server.properties > kafka.log 2>&1 &\n\n# Fetch Kafka secret securely from AWS Secrets Manager using dynamic secret name placeholder\nSECRET_VALUE=$(aws secretsmanager get-secret-value \\\n  --secret-id ",
        {
         "Fn::Join": [
          "-",
          [
           {
            "Fn::Select": [
             0,
             {
              "Fn::Split": [
               "-",
               {
                "Fn::Select": [
                 6,
                 {
                  "Fn::Split": [
                   ":",
                   {
                    "Ref": "KafkaSecret78EF3770"
                   }
                  ]
                 }
                ]
               }
              ]
             }
            ]
           },
           {
            "Fn::Select": [
             1,
             {
              "Fn::Split": [
               "-",
               {
                "Fn::Select": [
                 6,
                 {
                  "Fn::Split": [
                   ":",
                   {
                    "Ref": "KafkaSecret78EF3770"
                   }
                  ]
                 }
                ]
               }
              ]
             }
            ]
           }
          ]
         ]
        },
        " \\\n  --region us-east-1 \\\n  --query SecretString \\\n  --output text)\n\n# Extract Kafka username and password from the secret\nKAFKA_USERNAME=$(echo $SECRET_VALUE | python3 -c \"import sys, json; print(json.load(sys.stdin)['kafka_username'])\")\nKAFKA_PASSWORD=$(echo $SECRET_VALUE | python3 -c \"import sys, json; print(json.load(sys.stdin)['kafka_password'])\")\n\necho \"Kafka username fetched from Secrets Manager\"\n"
       ]
      ]
     }
    }
